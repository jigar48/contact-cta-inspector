{
  "name": "contact-cta-inspector",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "author": "Jigar Prajapati",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/package.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "package:check": "node scripts/inspect-package.mjs",
    "reproducibility": "node scripts/reproduce.mjs",
    "source:review": "node scripts/review-source.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.18.0",
    "eslint": "^10.13.0",
    "fflate": "^0.8.2",
    "jsdom": "^27.0.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
