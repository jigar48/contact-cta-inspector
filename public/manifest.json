{
  "manifest_version": 3,
  "name": "Contact CTA Inspector",
  "version": "1.1.0",
  "description": "Inspect contact links on demand. Find invalid formats and suspicious placeholders without sending page data anywhere.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_popup": "index.html",
    "default_title": "Contact CTA Inspector"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
